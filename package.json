  "main": "src/index.js",
  "module": "src/index.js",
  "unpkg": "src/index.js",
  "scripts": {
    "docs:dev": "vitepress dev ./",
    "docs:build": "vitepress build ./",
    "docs:preview": "vitepress preview ./",
    "explore:generate-data": "node scripts/generate-explore-data.js",
    "ai:extract-categories": "node scripts/extract-categories.js",
    "ai:extract-readmes": "node scripts/extract-readmes.js --tui",
    "ai:extract-rejected-readmes": "node scripts/extract-readmes.js --tui --input data/rejected-projects",
