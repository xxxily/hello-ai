    "typescript": "^4.9.3",
    "vite": "^8.0.1",
    "vite-plugin-babel": "^1.1.2",
    "vitepress": "1.6.4",
    "vitest": "^0.25.2",
    "vue": "^3.2.45"
  },
  "dependencies": {
    "core-js": "^3.26.1",
    "dotenv": "^17.3.1",
    "node-telegram-bot-api": "^0.66.0",
    "terser": "^5.16.0"
